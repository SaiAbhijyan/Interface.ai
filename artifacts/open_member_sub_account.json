      "url": "http://127.0.0.1:4173/open-account.html",
      "irreversible": false,
      "recoverableHints": []
    },
    {
      "id": "s2",
      "action": "fill",
      "description": "Enter Member ID",
      "locator": {
        "strategy": "label",
        "value": "Member ID",
