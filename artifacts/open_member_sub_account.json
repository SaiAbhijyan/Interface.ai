{
  "version": "1.0.0",
  "name": "open_member_sub_account",
  "description": "Open a new sub-account for a member through the wizard and reach the confirmation/complete screen.",
  "target": {
    "kind": "web",
    "entryUrl": "http://127.0.0.1:4173",
    "appId": "legacy-bank-mock"
  },
  "parameters": [
