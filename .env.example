# Preferred LLM provider for discovery (observe / decide / act)
OPENAI_API_KEY=

# Optional override
# OPENAI_MODEL=gpt-4o

# Mock bank base URL (must match an allowed origin)
# BANK_MOCK_URL=http://127.0.0.1:4173

# Full origins only (scheme+host+port). Blocks localhost SSRF to other ports.
# ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Exact paths / optional prefixes (do not set prefix to /)
# ALLOWED_PATHS=/,/index.html,/lookup.html,/open-account.html,/results.html,/bank-logic.js
# ALLOWED_PATH_PREFIXES=

# HITL: mock auto-resolves; manual requires waitForOperator (fail-closed)
HITL_MODE=mock
